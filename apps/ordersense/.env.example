# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Anthropic (console.anthropic.com -> API keys). Server-only, never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model used for column mapping, name cleaning and explanations.
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: the public URL of the deployed app (used for auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3100
