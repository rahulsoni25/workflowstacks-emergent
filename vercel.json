{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "crons": [
    {
      "path": "/api/cron/refresh-skills",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/security-monitor",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/enrich-batch",
      "schedule": "0 4 * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(AhrefsBot|SemrushBot|MJ12bot|DotBot|Bytespider|DataForSeoBot|BLEXBot|PetalBot|serpstatbot|MegaIndex|SeekportBot|Barkrowler|ZoominfoBot).*"
        }
      ],
      "mitigate": {
        "action": "deny"
      }
    }
  ],
  "headers": [
    {
      "source": "/api/(skills|packs|personas|playbooks)/([^/]+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "isr"
        }
      ]
    },
    {
      "source": "/api/(skills|packs|personas|playbooks|problems|members|community|deals|templates)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=600, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/api/stacks/([^/]+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=600, stale-while-revalidate=3600"
        }
      ]
    }
  ]
}
