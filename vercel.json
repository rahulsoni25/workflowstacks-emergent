{
  "crons": [
    {
      "path": "/api/cron/refresh-skills",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/security-monitor",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/enrich-batch",
      "schedule": "0 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(skills|packs|personas|playbooks)/([^/]+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/api/(skills|packs|personas|playbooks|problems|members|community|deals|templates)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=600, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/api/stacks/([^/]+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=600, stale-while-revalidate=3600"
        }
      ]
    }
  ]
}
