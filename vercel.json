{
  "crons": [
    {
      "path": "/api/cron/security-monitor",
      "schedule": "0 2 * * *"
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)reports' ':(exclude)docs' ':(exclude).github' ':(exclude)test_reports' ':(exclude)tests' ':(exclude)memory' ':(exclude)scripts' ':(exclude)cli' ':(exclude)plugins' ':(exclude).claude' ':(exclude).claude-plugin' ':(exclude).emergent' ':(exclude)backend_test.py' ':(exclude)test_result.md'",
  "headers": [
    {
      "source": "/api/(skills|packs|personas|playbooks)/([^/]+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/api/(skills|packs|personas|playbooks|problems|members|community|deals|templates)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=600, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/api/stacks/([^/]+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=600, stale-while-revalidate=3600"
        }
      ]
    }
  ]
}
